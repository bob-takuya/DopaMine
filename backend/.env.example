# DopaMine backend environment
# SRS engine: "fsrs" (local py-fsrs fallback, default) or "anki" (Anki collection)
DOPAMINE_SRS_ENGINE=fsrs

# Directory holding game.sqlite3 and srs.sqlite3 (default: backend/data)
DOPAMINE_DATA_DIR=./data

# Secret used to derive per-review RNG seeds (HMAC-SHA256). Set a real value in any
# shared environment; do not reuse the dev default.
DOPAMINE_SERVER_SECRET=change-me-dev-secret

# Extra allowed CORS origin for the frontend (localhost:5173 and :3000 are always allowed)
DOPAMINE_FRONTEND_ORIGIN=http://localhost:5173
